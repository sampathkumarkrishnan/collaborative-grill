{
  "name": "collaborative-grill",
  "private": true,
  "description": "Hackathon POC: collaborative Room with a Cursor Agent",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dev:server": "pnpm --filter @collaborative-grill/server run dev",
    "dev:web": "pnpm --filter @collaborative-grill/web run dev",
    "dev:daemon": "pnpm --filter @collaborative-grill/daemon run dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "@types/node": "^20.16.11"
  }
}
