{
  "name": "@collaborative-grill/daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Host-side process shell; connects to the Server, routes Relays to the Agent (ticket 4 builds out the SDK pool)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@collaborative-grill/shared": "workspace:*",
    "@cursor/sdk": "^1.0.37",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
