{
  "name": "@collaborative-grill/web",
  "version": "0.1.0",
  "private": true,
  "description": "Web app shell; browser client for Members and the Host (ticket 3 builds out Room list, join, composer, transcript view)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
